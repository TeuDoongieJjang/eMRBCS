                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <HorizontalStackLayout Grid.Row="0" Grid.Column="0" >
                    <Image Source="menuicons/prev.png"  
    HeightRequest="50" 
    WidthRequest="50" >
                        <Image.GestureRecognizers>
                            <TapGestureRecognizer Tapped="TapImgBack" />
                        </Image.GestureRecognizers>
                    </Image>
                    <Label Margin="5,0,0,0"
Text="Consumer List"
TextColor="White"
FontSize="18"    
VerticalOptions="Center"
HorizontalOptions="Start"/>
                   
                </HorizontalStackLayout>
                <Image Source="menuicons/options1.png"  Grid.Row="0" Grid.Column="1" HorizontalOptions="End" x:Name="imgoption"
HeightRequest="50" 
WidthRequest="50" >
                    <Image.GestureRecognizers>
                        <TapGestureRecognizer Tapped="TapShowOPtions" />
                    </Image.GestureRecognizers>
                </Image>


            </Grid>
            <Grid x:Name="gridFilter"
                Margin="0,10,0,10" Grid.Row="1" Grid.Column="0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Picker x:Name="pickerBillingFilter"
        SelectedIndexChanged="OnConsumerTypeChanged"
        HorizontalOptions="StartAndExpand"        
        Grid.Row="0"
        Grid.Column="0"                    
        Margin="5,0,0,0"
        Title="Choose Consumer Status" />
                <Label x:Name="lblSummaryCount" 
           HorizontalOptions="End"
           Text="0 / 0"
           FontSize="22"
           FontAttributes="Bold"
           Margin="0,0,20,0"
           Grid.Row="0"
            Grid.Column="1"   
           />

            </Grid>
            <Grid x:Name="gridSearch" 
                Margin="5,0,0,10" Grid.Row="2" Grid.Column="0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Picker x:Name="pickerFiledFilter"      
                        Grid.Row="0" Grid.Column="0"
     Title="Choose Filter" />
                <SearchBar x:Name="searchFilterName" 
                           Grid.Row="0" Grid.Column="1"
                          WidthRequest="200"                          
     TextChanged="OnSearchClear"  
     TextColor="Red"
     Placeholder="Search consumer"/>
                <Button x:Name="btnSearchFilter" 
                        Grid.Row="0" Grid.Column="2"
                    Clicked="OnSearchFilter_new"                
                Text="Go"      
                BackgroundColor="#3269cd"
                        HorizontalOptions="End"
                Margin="5,5,5,0" />
            </Grid>          
                
