<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:eMRBCS.ViewModels"
             xmlns:models="clr-namespace:eMRBCS.Models"
             x:Class="eMRBCS.Pages.ReadingConsumers"
             x:DataType="vm:ReadingConsumersViewModel"
             NavigationPage.HasNavigationBar="False"
             Title="ReadingConsumers"
             xmlns:helpers="clr-namespace:eMRBCS.Helpers">

    <Grid RowDefinitions="Auto,Auto,Auto,*">

        <!-- Header -->
        <Grid Grid.Row="0" BackgroundColor="#3269cd" Padding="10" ColumnDefinitions="*,Auto">
            <HorizontalStackLayout>
                <Image Source="menuicons/prev.png" HeightRequest="50" WidthRequest="50">
                    <Image.GestureRecognizers>
                        <TapGestureRecognizer Tapped="TapImgBack" />
                    </Image.GestureRecognizers>
                </Image>
                <Label Text="Consumer List" TextColor="White" helpers:ResponsiveFont.BaseSize="18"
                       VerticalOptions="Center" Margin="5,0,0,0" />
            </HorizontalStackLayout>
            <Image Grid.Column="1" Source="{Binding OptionsIcon}" HeightRequest="50" WidthRequest="50">
                <Image.GestureRecognizers>
                    <TapGestureRecognizer Command="{Binding ToggleOptionsCommand}" />
                </Image.GestureRecognizers>
            </Image>
        </Grid>

        <ProgressBar Grid.Row="2" Progress="{Binding Store.LoadProgress}" ProgressColor="#3269cd"
                     IsVisible="{Binding Store.IsLoading}" />

        <!-- Row 1 : Summary + filters + search in ONE tight stack -->
        <VerticalStackLayout Grid.Row="1" IsVisible="{Binding ShowOptions}"
                         Spacing="0" Margin="5,5,5,5">

            <!-- Summary row: no bottom padding, text centered vertically -->
            <Grid ColumnDefinitions="*,Auto" Padding="5,0,5,0">
                <Label Text="{Binding Store.StatusText}" FontSize="13" TextColor="Gray"
                   VerticalOptions="Center" />
                <Label Grid.Column="1" Text="{Binding SummaryText}"
                   TextColor="{Binding SummaryColor}"
                   FontSize="22" FontAttributes="Bold"
                   VerticalOptions="Center" />
            </Grid>

            <Picker ItemsSource="{Binding BillingFilters}"
                SelectedIndex="{Binding SelectedFilterIndex}"
                Title="Choose Consumer Status" />

            <Grid ColumnDefinitions="Auto,*,Auto">
                <Picker ItemsSource="{Binding SearchFields}"
                    SelectedIndex="{Binding SelectedSearchFieldIndex}"
                    Title="Choose Filter" />
                <SearchBar Grid.Column="1" Text="{Binding SearchText}" TextColor="Red"
                       SearchCommand="{Binding SearchCommand}"
                       Placeholder="Search consumer" />
                <Button Grid.Column="2" Text="Go" BackgroundColor="#3269cd" Margin="5,0"
                    Command="{Binding SearchCommand}" />
            </Grid>
        </VerticalStackLayout>

        <!-- Virtualized list -->
        <CollectionView Grid.Row="3" ItemsSource="{Binding Items}" SelectionMode="None"
                        ItemSizingStrategy="MeasureFirstItem"
                        ItemsUpdatingScrollMode="KeepScrollOffset">
            <CollectionView.EmptyView>
                <Label Text="{Binding EmptyText}" HorizontalOptions="Center" Margin="20" />
            </CollectionView.EmptyView>
            <CollectionView.ItemTemplate>
                <DataTemplate x:DataType="models:ConsumerRow">
                    <Grid Margin="10,6">

                        <!-- Shadow layer -->
                        <Border BackgroundColor="#33000000" StrokeThickness="0">
                            <Border.StrokeShape>
                                <RoundRectangle CornerRadius="11" />
                            </Border.StrokeShape>
                        </Border>

                        <!-- Card layer -->
                        <Border BackgroundColor="White" StrokeThickness="0"
                                Padding="12,8" MinimumHeightRequest="86"
                                Margin="5,1,5,5">
                            <Border.StrokeShape>
                                <RoundRectangle CornerRadius="8" />
                            </Border.StrokeShape>
                            <Border.GestureRecognizers>
                                <TapGestureRecognizer Tapped="OnRowTapped" />
                            </Border.GestureRecognizers>

                            <Grid ColumnDefinitions="Auto,Auto,*" RowDefinitions="Auto,Auto"
                                  ColumnSpacing="6" RowSpacing="2">

                                <!-- Row 0 : Account No. + Name -->
                                <VerticalStackLayout Grid.Column="0" Grid.Row="0" Spacing="0">
                                    <Label Text="Account No:" FontAttributes="Bold"
                                           helpers:ResponsiveFont.BaseSize="12" TextColor="Black" />
                                    <Label Text="{Binding AccountNo}" FontAttributes="Bold"
                                           helpers:ResponsiveFont.BaseSize="16" TextColor="Black" />
                                </VerticalStackLayout>

                                <Image Grid.Column="1" Grid.Row="0"
                                       Source="menuicons/person.png"
                                       HeightRequest="25" WidthRequest="25"
                                       VerticalOptions="Start" />

                                <Label Grid.Column="2" Grid.Row="0"
                                       Text="{Binding Name}" FontAttributes="Bold"
                                       helpers:ResponsiveFont.BaseSize="14" TextColor="Black"
                                       MaxLines="2" LineBreakMode="TailTruncation"
                                       VerticalOptions="Start" />   

                                <!-- Row 1 : Meter No. + Address -->
                                <VerticalStackLayout Grid.Column="0" Grid.Row="1" Spacing="0">
                                    <Label Text="Meter No:" FontAttributes="Bold"
                                           helpers:ResponsiveFont.BaseSize="12" TextColor="Black" />
                                    <Label Text="{Binding MeterNo}" FontAttributes="Bold"
                                           helpers:ResponsiveFont.BaseSize="16" TextColor="Black" />
                                </VerticalStackLayout>

                                <Image Grid.Column="1" Grid.Row="1"
                                       Source="menuicons/address.png"
                                       HeightRequest="25" WidthRequest="25"
                                       VerticalOptions="Start" />

                                <Label Grid.Column="2" Grid.Row="1"
                                       Text="{Binding Address}"
                                       helpers:ResponsiveFont.BaseSize="12" TextColor="Black"
                                       MaxLines="2" LineBreakMode="TailTruncation"
                                       VerticalOptions="Start" />
                            </Grid>
                        </Border>
                    </Grid>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>
    </Grid>
</ContentPage>