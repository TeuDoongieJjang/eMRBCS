<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="eMRBCS.Pages.AppSettings"
             NavigationPage.HasNavigationBar="False"
             Title="AppSettings">
    <ScrollView>
        <VerticalStackLayout>
            <Grid x:Name="grid_server">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <!--IP Address-->
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <!--Folder-->
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <!--User-->
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <!--Pass-->
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <!--Export-->
                    <RowDefinition Height="Auto" />
                    <!--IP Address-->
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <!--Folder-->
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <!--User-->
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <!--Pass-->
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <!--Button-->
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <!-- Row 1-->
                <BoxView Color="#3269cd"
                      HorizontalOptions="FillAndExpand"
                      VerticalOptions="FillAndExpand"
                      HeightRequest="70" 
                      Grid.Row="0"
                      Grid.Column="0"/>
                <AbsoluteLayout Grid.Row="0"
                        Grid.Column="0">
                    <Image Source="menuicons/prev.png"                      
                          AbsoluteLayout.LayoutBounds="10,10"
                          HeightRequest="50" 
                          WidthRequest="50" >
                        <Image.GestureRecognizers>
                                <TapGestureRecognizer Tapped="TapImgBack" />
                            </Image.GestureRecognizers>
                        </Image>
                    <Label 
                         Text="Utilities"
                         TextColor="White"
                         FontSize="18"
                         AbsoluteLayout.LayoutBounds="70,20"
                         VerticalOptions="Start"
                         HorizontalOptions="Start"/>
                    
                </AbsoluteLayout>

                <!--#IP Address -->
                <!-- Row 2-->
                <Grid Grid.Row="1" Grid.Column="0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <AbsoluteLayout Grid.Row="0"
           Grid.Column="0">
                        <Label TextColor="Black"       
                             FontAttributes="Bold"
 Text="Status"
 AbsoluteLayout.LayoutBounds="10,15"                            
 Margin="10,5,0,0"                 
 FontSize="14" />
                        <Frame x:Name="frameStatus" 
                          AbsoluteLayout.LayoutBounds="70,20"
HeightRequest="20"
   WidthRequest="20"
   CornerRadius="75"
   BackgroundColor="Green" />
                    </AbsoluteLayout>
                    <AbsoluteLayout Grid.Row="0"
                        Grid.Column="1">
                        <Rectangle Fill="#3269cd"   
                            WidthRequest="200"
                            HeightRequest="40"
                            AbsoluteLayout.LayoutBounds="10,10"
                            RadiusX="0"
                            RadiusY="10" />
                        <Button TextColor="White"             
                                Text="Save Server Configuration"
                                Clicked="OnSaveChanges"
                                AbsoluteLayout.LayoutBounds="20,15"                            
                                Margin="10,5,0,0"                 
                                FontSize="14" />
                    </AbsoluteLayout>
                    <Label Grid.Row="1"
                        Grid.Column="0"
                        Text="Getting Data Details"
                        Margin="10"
                        FontSize="14"
                        VerticalOptions="Start"
                        HorizontalOptions="Start"/>
                </Grid>
               

                <!-- Row 3-->
                <Label  Grid.Row="2"
                    Grid.Column="0"
                    Text="IP Address:"
                    Margin="10,5,0,0"
                    FontSize="14"
                    VerticalOptions="Start"
                    HorizontalOptions="Start"/>

                <!-- Row 4-->
                <Frame BorderColor="Gray" CornerRadius="2" Padding="0" Margin="10" Grid.Row="3" Grid.Column="0">
                    <Entry  x:Name="import_ipaddress"                            
                            Placeholder="192.168.1.1"
                            TextChanged="OnIpAddressChanged"
                            Margin="10,5,0,0"
                            FontSize="12"
                            VerticalOptions="Start"                        
                            HorizontalOptions="Fill"/>
                </Frame>
                <!--#End IP Address -->

                <!--#Shared Folder -->
                <!-- Row 3-->
                <Label  Grid.Row="4"
                    Grid.Column="0"
                    Text="Shared Folder:"
                    Margin="10,5,0,0"
                    FontSize="14"
                    VerticalOptions="Start"
                    HorizontalOptions="Start"/>

                <!-- Row 4-->
                <Frame BorderColor="Gray" CornerRadius="2" Padding="0" Margin="10" Grid.Row="5"
                        Grid.Column="0">
                    <Entry  x:Name="import_sharedfolder"
                        Placeholder="Folder Name"
                        Margin="10,5,0,0"
                        FontSize="12"
                        VerticalOptions="Start"                        
                        HorizontalOptions="Fill"/>
                </Frame>
                <!--#End Shared Folder -->

                <!--#User -->
                <!-- Row 3-->
                <Label  Grid.Row="6"
                    Grid.Column="0"
                    Text="Username:"
                    Margin="10,5,0,0"
                    FontSize="14"
                    VerticalOptions="Start"
                    HorizontalOptions="Start"/>

                <!-- Row 4-->
                <Frame BorderColor="Gray" CornerRadius="2" Padding="0" Margin="10" Grid.Row="7"
                        Grid.Column="0">
                    <Entry  x:Name="import_username"
                        Placeholder="admin"
                        Margin="10,5,0,0"
                        FontSize="12"
                        VerticalOptions="Start"                        
                        HorizontalOptions="Fill"/>
                </Frame>
                <!--#End User -->

                <!--#Pass -->
                <!-- Row 3-->
                <Label  Grid.Row="8"
                    Grid.Column="0"
                    Text="Password:"
                    Margin="10,5,0,0"
                    FontSize="14"
                    VerticalOptions="Start"
                    HorizontalOptions="Start"/>

                <!-- Row 4-->
                <Frame BorderColor="Gray" CornerRadius="2" Padding="0" Margin="10" Grid.Row="9" Grid.Column="0">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Entry x:Name="import_pass" 
                               Grid.Column="0"
                               Margin="10,5,0,0"
                               FontSize="12"
                               VerticalOptions="Center"                        
                               HorizontalOptions="Fill"
                               IsPassword="True"/>
                        <ImageButton x:Name="btnToggleImportPass" 
                                     Grid.Column="1"
                                     Source="menuicons/eye.png"
                                     HeightRequest="22"
                                     WidthRequest="22"
                                     MinimumHeightRequest="22"
                                     MinimumWidthRequest="22"
                                     Padding="0"
                                     Margin="0,0,10,0"
                                     Aspect="AspectFit"
                                     BackgroundColor="Transparent"
                                     VerticalOptions="Center" 
                                     Clicked="OnToggleImportPassword" />
                    </Grid>
                </Frame>
                <!--#EndPass -->
                
<!--#Export Details -->

                <!-- Row 3--><!--
                <Label  Grid.Row="10"
                    Grid.Column="0"
                    Text="Sending Data Details"
                    Margin="10,5,0,0"
                    FontSize="14"
                    VerticalOptions="Start"
                    HorizontalOptions="Start"/>-->

                <HorizontalStackLayout Grid.Row="11"
                    Grid.Column="0">
                    <CheckBox x:Name="chkSameDetails"
                        IsChecked="false"
                        CheckedChanged="OnCheckSameDetails"
                        HorizontalOptions="Start"/>
                    <Label  Text="Sending Data - Same as above"
                        Margin="0,10,0,0"
                        FontSize="14"                        
                        HorizontalOptions="Start"/>

                </HorizontalStackLayout>

                <!-- Row 3-->
                <Label  Grid.Row="12"
                    Grid.Column="0"
                    Text="IP Address:"
                    Margin="10,5,0,0"
                    FontSize="14"
                    VerticalOptions="Start"
                    HorizontalOptions="Start"/>

                <!-- Row 4-->
                <Frame BorderColor="Gray" CornerRadius="2" Padding="0" Margin="10" Grid.Row="13" Grid.Column="0">
                    <Entry  x:Name="export_ipaddress"                            
                            Placeholder="192.168.1.1"
                            TextChanged="OnIpAddressChanged"
                            Margin="10,5,0,0"
                            FontSize="12"
                            VerticalOptions="Start"                        
                            HorizontalOptions="Fill"/>          
                </Frame>
                <!--#End IP Address -->

                <!--#Shared Folder -->
                <!-- Row 3-->
                <Label  Grid.Row="14"
                    Grid.Column="0"
                    Text="Shared Folder:"
                    Margin="10,5,0,0"
                    FontSize="14"
                    VerticalOptions="Start"
                    HorizontalOptions="Start"/>

                <!-- Row 4-->
                <Frame BorderColor="Gray" CornerRadius="2" Padding="0" Margin="10" Grid.Row="15"
                    Grid.Column="0">
                    <Entry  x:Name="export_sharedfolder"
                        Placeholder="Folder Name"
                        Margin="10,5,0,0"
                        FontSize="12"
                        VerticalOptions="Start"                        
                        HorizontalOptions="Fill"/>
                </Frame>
                <!--#End Shared Folder -->

                <!--#User -->
                <!-- Row 3-->
                <Label  Grid.Row="16"
                    Grid.Column="0"
                    Text="Username:"
                    Margin="10,5,0,0"
                    FontSize="14"
                    VerticalOptions="Start"
                    HorizontalOptions="Start"/>

                <!-- Row 4-->
                <Frame BorderColor="Gray" CornerRadius="2" Padding="0" Margin="10" Grid.Row="17"
                    Grid.Column="0">
                    <Entry  x:Name="export_username"
                        Placeholder="admin"
                        Margin="10,5,0,0"
                        FontSize="12"
                        VerticalOptions="Start"                        
                        HorizontalOptions="Fill"/>
                </Frame>
                <!--#End User -->

                <!--#Pass -->
                <!-- Row 3-->
                <Label  Grid.Row="18"
                    Grid.Column="0"
                    Text="Password:"
                    Margin="10,5,0,0"
                    FontSize="14"
                    VerticalOptions="Start"
                    HorizontalOptions="Start"/>

                <!-- Row 4-->
                <Frame BorderColor="Gray" CornerRadius="2" Padding="0" Margin="10" Grid.Row="19" Grid.Column="0">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Entry x:Name="export_pass" 
                               Grid.Column="0"
                               Margin="10,5,0,0"
                               FontSize="12"
                               VerticalOptions="Center"                        
                               HorizontalOptions="Fill"
                               IsPassword="True"/>
                        <ImageButton x:Name="btnToggleExportPass" 
                                     Grid.Column="1"
                                     Source="menuicons/eye.png"
                                     HeightRequest="22"
                                     WidthRequest="22"
                                     MinimumHeightRequest="22"
                                     MinimumWidthRequest="22"
                                     Padding="0"
                                     Margin="0,0,10,0"
                                     Aspect="AspectFit"
                                     BackgroundColor="Transparent"
                                     VerticalOptions="Center" 
                                     Clicked="OnToggleExportPassword" />
                    </Grid>
                </Frame>
                <!--#End Pass -->
                <Button Text="Save Changes"
                    Clicked="OnSaveChanges"
                    BackgroundColor="#3269cd"
                    Grid.Row="20"
                    Grid.Column="0" />
            </Grid>
          


        </VerticalStackLayout>
    </ScrollView>
</ContentPage>