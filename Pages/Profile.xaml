<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="eMRBCS.Pages.Profile"
             NavigationPage.HasNavigationBar="False"
             Title="Profile">
    <ScrollView>
        <VerticalStackLayout>
            <Grid>
                <Grid VerticalOptions="Start" 
            ZIndex="1">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>


                    <BoxView Color="#3269cd"
             HorizontalOptions="FillAndExpand"
             VerticalOptions="FillAndExpand"
             HeightRequest="70" 
             Grid.Row="0"
             Grid.Column="0"/>


                    <AbsoluteLayout Grid.Row="0"
            Grid.Column="0">
                        <Image Source="menuicons/prev.png"                      
                 AbsoluteLayout.LayoutBounds="10,10"
                 HeightRequest="50" 
                 WidthRequest="50" >
                            <Image.GestureRecognizers>
                                <TapGestureRecognizer Tapped="TapImgBack" />
                            </Image.GestureRecognizers>
                        </Image>
                        <Label 
                Text="Profile"
                TextColor="White"
                FontSize="18"
                AbsoluteLayout.LayoutBounds="70,20"
                VerticalOptions="Start"
                HorizontalOptions="Start"/>
                    </AbsoluteLayout>
                    <Grid Grid.Row="1" Grid.Column="0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <AbsoluteLayout Grid.Row="0"
         Grid.Column="1">
                            <Rectangle Fill="#3269cd"   
             WidthRequest="200"
             HeightRequest="40"
             AbsoluteLayout.LayoutBounds="10,10"
             RadiusX="0"
             RadiusY="10" />
                            <Label TextColor="White"             
                 Text="User Information"
                 AbsoluteLayout.LayoutBounds="30,15"                            
                 Margin="10,5,0,0"                 
                 FontSize="14" />
                        </AbsoluteLayout>

                    </Grid>
                    <!-- Row 3-->
                    <Label  Grid.Row="2"
      Grid.Column="0"
      Text="Name:"
      Margin="10,5,0,0"
      FontSize="14"
      VerticalOptions="Start"
      HorizontalOptions="Start"/>

                    <!-- Row 4-->
                    <Frame BorderColor="Gray" CornerRadius="2" Padding="0" Margin="10" Grid.Row="3"
          Grid.Column="0">
                        <Entry  x:Name="txtname"                            
          Placeholder="Juan dela Cruz"
          Margin="10,5,0,0"
          FontSize="12"
          VerticalOptions="Start"                        
          HorizontalOptions="Fill"/>
                    </Frame>

                    <Label  Grid.Row="4"
     Grid.Column="0"
     Text="Position:"
     Margin="10,5,0,0"
     FontSize="14"
     VerticalOptions="Start"
     HorizontalOptions="Start"/>

                    <!-- Row 4-->
                    <Frame BorderColor="Gray" CornerRadius="2" Padding="0" Margin="10" Grid.Row="5"
         Grid.Column="0">
                        <Entry  x:Name="txtposition"
         Placeholder="Administrator"
         Margin="10,5,0,0"
         FontSize="12"
         VerticalOptions="Start"                        
         HorizontalOptions="Fill"/>
                    </Frame>

                    <Label  Grid.Row="6"
    Grid.Column="0"
    Text="Username:"
    Margin="10,5,0,0"
    FontSize="14"
    VerticalOptions="Start"
    HorizontalOptions="Start"/>

                    <!-- Row 4-->
                    <Frame BorderColor="Gray" CornerRadius="2" Padding="0" Margin="10" Grid.Row="7"
        Grid.Column="0">
                        <Entry  x:Name="txtusername"
        Placeholder="admin"
        Margin="10,5,0,0"
        FontSize="12"
        VerticalOptions="Start"                        
        HorizontalOptions="Fill"/>
                    </Frame>
                    <Button x:Name="btnSaveChanges" 
                        Text="Save Changes"
                            Clicked="OnSaveChanges"
Margin="0,10,0,0"
BackgroundColor="#3269cd"
Grid.Row="11"
Grid.Column="0" />


                    <Button x:Name="btnUpdatePass" 
                        Text="Update Password"
                            Clicked="OnUpdatePassword"
     Margin="0,10,0,0"
     BackgroundColor="#3269cd"
     Grid.Row="12"
     Grid.Column="0" />


                </Grid>
                <Grid x:Name="gridChangePass"
                      IsVisible="False"
                    VerticalOptions="Center"
               HorizontalOptions="Center"
             ZIndex="2">
                   
                    
                    <BoxView Color="#3269cd"
HorizontalOptions="FillAndExpand"
VerticalOptions="FillAndExpand"
HeightRequest="240" 
                      WidthRequest="320"
                             CornerRadius="10"
/>
                    <BoxView Color="White"
HorizontalOptions="FillAndExpand"
VerticalOptions="FillAndExpand"
HeightRequest="220" 
                      WidthRequest="300"
                             CornerRadius="10"
/>

                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Entry  x:Name="txtoldpass"
                                Grid.Row="0" Grid.Column="0"
                                IsPassword="True"
Placeholder="Old Password"
Margin="20,20,20,10"
FontSize="14"
VerticalOptions="Start"                        
HorizontalOptions="Fill"/>
                        <Entry  x:Name="txtnewpass"
                                Grid.Row="1" Grid.Column="0"
                                IsPassword="True"
Placeholder="New Password"
Margin="20,0,20,10"
FontSize="14"
VerticalOptions="Start"                        
HorizontalOptions="Fill"/>
                        <Entry  x:Name="txtconfirmpass"
                                Grid.Row="2" Grid.Column="0"
                                IsPassword="True"
Placeholder="Confirm Password"
Margin="20,0,20,10"
FontSize="14"
VerticalOptions="Start"                        
HorizontalOptions="Fill"/>
                        <Grid Grid.Row="3" Grid.Column="0">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />                               
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Button x:Name="btnSavePass" 
    Clicked="OnSavePass"
Grid.Row="0" Grid.Column="0"
                                    WidthRequest="120"
    HorizontalOptions="CenterAndExpand"        
    BackgroundColor="#3269cd"
    Text="Save Password"
/>
                            <Button x:Name="btnCancel"
                                    Clicked="OnCancel"
                                    WidthRequest="120"
    Grid.Row="0" Grid.Column="1"
        HorizontalOptions="CenterAndExpand"          
        BackgroundColor="#3269cd"
        Text="Cancel"
    />
                        </Grid>
                        
                    </Grid>
                  
                    




                </Grid>
            </Grid>
            
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>