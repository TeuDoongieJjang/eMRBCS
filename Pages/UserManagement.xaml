<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="eMRBCS.Pages.UserManagement"
             NavigationPage.HasNavigationBar="False"
             Title="UserManagement">
    <ScrollView>
        <VerticalStackLayout>
            <Grid>
                <Grid VerticalOptions="Start" 
            ZIndex="1">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>


                    <BoxView Color="#3269cd"
             HorizontalOptions="FillAndExpand"
             VerticalOptions="FillAndExpand"
             HeightRequest="70" 
             Grid.Row="0"
             Grid.Column="0"/>


                    <AbsoluteLayout Grid.Row="0"
            Grid.Column="0">
                        <Image Source="menuicons/prev.png"                      
                 AbsoluteLayout.LayoutBounds="10,10"
                 HeightRequest="50" 
                 WidthRequest="50" >
                            <Image.GestureRecognizers>
                                <TapGestureRecognizer Tapped="TapImgBack" />
                            </Image.GestureRecognizers>
                        </Image>
                        <Label 
                Text="User Management"
                TextColor="White"
                FontSize="18"
                AbsoluteLayout.LayoutBounds="70,20"
                VerticalOptions="Start"
                HorizontalOptions="Start"/>
                    </AbsoluteLayout>
                    <Grid Grid.Row="1" Grid.Column="0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <AbsoluteLayout Grid.Row="0"
         Grid.Column="1">
                            <Rectangle Fill="#3269cd"   
             WidthRequest="200"
             HeightRequest="40"
             AbsoluteLayout.LayoutBounds="10,10"
             RadiusX="0"
             RadiusY="10" />
                            <Label TextColor="White"             
                 Text="Available Users"
                 AbsoluteLayout.LayoutBounds="30,15"                            
                 Margin="10,5,0,0"                 
                 FontSize="14" />
                        </AbsoluteLayout>

                    </Grid>
                    <ScrollView Margin="10" 
                        Grid.Row="3"
            Grid.Column="0"
                                HeightRequest="150"
                                >
                        <Grid >
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <ListView x:Name="lstUsers"
                                  Grid.Row="0"
                                  Grid.Column="0" />
                            <Label x:Name="lblnodata" 
                            Text="No available users"
                               FontSize="14"
                               Margin="0,30,0,0"
                               FontAttributes="Bold"
                               Grid.Row="0"
Grid.Column="0"
                               HorizontalOptions="Center"
                               IsVisible="false"
                            />


                        </Grid>
                    </ScrollView>
                    <Grid Grid.Row="4"
Grid.Column="0" >
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Button x:Name="btnEditUser"
                        Text="Update User"
                                Clicked="OnEditUser"
                            
Margin="10,10,10,0"
BackgroundColor="#3269cd"
Grid.Row="0"
Grid.Column="1" />
                        <Button x:Name="btnNewUser"
                        Text="New User"
                            Clicked="OnNewUser"
Margin="10,10,10,0"
BackgroundColor="#3269cd"
Grid.Row="0"
Grid.Column="0" />
                        <BoxView Color="Gray"
HorizontalOptions="FillAndExpand"
VerticalOptions="FillAndExpand"
                                 Margin="20"
                                 CornerRadius="10"
                                 HeightRequest="5"
Grid.Row="1"
Grid.Column="0"
                                 Grid.ColumnSpan="2"/>
                    </Grid>
                    <Grid Grid.Row="5" Grid.Column="0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <AbsoluteLayout Grid.Row="0"
Grid.Column="1">
                            <Rectangle Fill="#3269cd"   
    WidthRequest="200"
    HeightRequest="40"
    AbsoluteLayout.LayoutBounds="10,10"
    RadiusX="0"
    RadiusY="10" />
                            <Label TextColor="White"             
        Text="User's Information"
        AbsoluteLayout.LayoutBounds="30,15"                            
        Margin="10,5,0,0"                 
        FontSize="14" />
                        </AbsoluteLayout>

                    </Grid>


                    <Grid  Grid.Row="6" Grid.Column="0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Label  Grid.Row="1"
      Grid.Column="0"
      Text="Name:"
      Margin="10,5,0,0"
      FontSize="14"
      VerticalOptions="Start"
      HorizontalOptions="Start"/>

                        <!-- Row 4-->
                        <Frame BorderColor="Gray" CornerRadius="2" Padding="0" Margin="10" Grid.Row="2"
          Grid.Column="0">
                            <Entry  x:Name="txtname"                       
          Placeholder="Juan dela Cruz"
          Margin="10,5,0,0"
          FontSize="12"
          VerticalOptions="Start"                        
          HorizontalOptions="Fill"/>
                        </Frame>

                        <Label  Grid.Row="3"
     Grid.Column="0"
     Text="Position:"
     Margin="10,5,0,0"
     FontSize="14"
     VerticalOptions="Start"
     HorizontalOptions="Start"/>

                        <!-- Row 4-->
                        <Frame BorderColor="Gray" CornerRadius="2" Padding="0" Margin="10" Grid.Row="4"
         Grid.Column="0">
                            <Entry  x:Name="txtposition"
         Placeholder="Administrator"
         Margin="10,5,0,0"
         FontSize="12"
         VerticalOptions="Start"                        
         HorizontalOptions="Fill"/>
                        </Frame>

                        <Label  Grid.Row="5"
    Grid.Column="0"
    Text="Username:"
    Margin="10,5,0,0"
    FontSize="14"
    VerticalOptions="Start"
    HorizontalOptions="Start"/>

                        <!-- Row 4-->
                        <Frame BorderColor="Gray" CornerRadius="2" Padding="0" Margin="10" Grid.Row="6"
        Grid.Column="0">
                            <Entry  x:Name="txtusername"
        Placeholder="admin"
        Margin="10,5,0,0"
        FontSize="12"
        VerticalOptions="Start"                        
        HorizontalOptions="Fill"/>
                        </Frame>
                        <Label  Grid.Row="7"
Grid.Column="0"
Text="Password:"
Margin="10,5,0,0"
FontSize="14"
VerticalOptions="Start"
HorizontalOptions="Start"/>

                        <!-- Row 4-->
                        <Frame BorderColor="Gray" CornerRadius="2" Padding="0" Margin="10" Grid.Row="8"
    Grid.Column="0">
                            <Entry  x:Name="txtpassword"
                                    IsPassword="True"
    Placeholder="admin"
    Margin="10,5,0,0"
    FontSize="12"
    VerticalOptions="Start"                        
    HorizontalOptions="Fill"/>
                        </Frame>

                        <Button x:Name="btnSaveUser"
                        Text="Save"                          
                                Clicked="OnSaveUser"
Margin="10,10,10,0"
BackgroundColor="#3269cd"
Grid.Row="9"
Grid.Column="0" />


                    </Grid>



                </Grid>
               
            </Grid>

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>