<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="eMRBCS.Pages.Utilities"
             NavigationPage.HasNavigationBar="False"
             Title="Utilities">

    <AbsoluteLayout>
        <StackLayout x:Name="stackLoading" IsVisible="false" AbsoluteLayout.LayoutBounds="0.5,0.3,200,25"
               AbsoluteLayout.LayoutFlags="PositionProportional"
                ZIndex="3" >
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <BoxView Color="Transparent"
                             
      HorizontalOptions="FillAndExpand"
      VerticalOptions="FillAndExpand"
     
      Grid.Row="0" Grid.RowSpan="3"
      Grid.Column="0"/>
                <ActivityIndicator x:Name="activityIndicatorPage" Grid.Column="0" Grid.Row="0"                
IsRunning="true"
Color="#3269cd"                   
HeightRequest="100"
WidthRequest="100"
IsVisible="true"
 />
                <Label x:Name="lblloading"
                        Text="Performing Task" HorizontalOptions="Center" FontAttributes="Bold" FontSize="16" Grid.Column="0" Grid.Row="1"    Margin="15,0,15,10"     TextColor="White"
    />
                <Label Text="Please wait" HorizontalOptions="Center" FontAttributes="Bold" FontSize="16" Grid.Column="0" Grid.Row="2"    Margin="15,0,15,10"     TextColor="White"
/>

            </Grid>


        </StackLayout>
        <ScrollView AbsoluteLayout.LayoutBounds="0.5,0,1,1"
                 AbsoluteLayout.LayoutFlags="SizeProportional">
        <Grid>
            <Grid VerticalOptions="Start" 
                ZIndex="1">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>


                <BoxView Color="#3269cd"
                        HorizontalOptions="FillAndExpand"
                        VerticalOptions="FillAndExpand"
                        HeightRequest="70" 
                        Grid.Row="0"
                        Grid.Column="0"/>

                <Grid Margin="10,10,10,10" Grid.Row="0" Grid.Column="0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <HorizontalStackLayout Grid.Row="0" Grid.Column="0" >
                        <Image Source="menuicons/prev.png"  
         HeightRequest="50" 
         WidthRequest="50" >
                            <Image.GestureRecognizers>
                                <TapGestureRecognizer Tapped="TapImgBack" />
                            </Image.GestureRecognizers>
                        </Image>
                        <Label Margin="5,0,0,0"
     Text="Utilities"
     TextColor="White"
     FontSize="18"    
      VerticalOptions="Center"
     HorizontalOptions="Start"/>
                    </HorizontalStackLayout>                  

                </Grid>

            
                <Grid Grid.Row="2"
                    Grid.Column="0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />

                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                </Grid>

                <Grid  Margin="0,10,0,0"
                    Grid.Row="3"
                    Grid.Column="0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Rectangle x:Name="recGetDataLower" 
                        Fill="Gray"                             
                        HeightRequest="90"                      
                        Margin="20,10,20,0"
                        RadiusX="10"
                        RadiusY="10"
                        Grid.Row="0"
                        Grid.Column="0" />
                    <Rectangle x:Name="recGetDataUpper"  
                        Fill="white"                      
                        Margin="20,0,20,0"                       
                        HeightRequest="90"                      
                        Stroke="Gray"
                        StrokeThickness="1"
                        RadiusX="10"
                        RadiusY="10"
                        Grid.Row="0"
                        Grid.Column="0" />
                    <Grid VerticalOptions="Center"
                        Grid.Row="0" Grid.Column="0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Image x:Name="imgGetData"  
                            Grid.Row="0"
                            Grid.Column="0"
                            Source="menuicons/import_file.png"                
                            VerticalOptions="Center"
                            HorizontalOptions="End"
                            Margin="0,0,20,0"
                            HeightRequest="75" 
                            WidthRequest="75" >
                        </Image>
                        <Label x:Name="lblGetData"
                            Grid.Row="0"
                            Grid.Column="1"
                            Text="Get Data"
                            TextColor="Black"
                            FontSize="18"
                           
                            VerticalOptions="Center"
                            HorizontalOptions="Start"/>
                    </Grid>
                 
                    <Frame x:Name="frmGetData"  
                    BackgroundColor="Transparent"
                    Margin="20,0,20,0"                   
    HeightRequest="90" 
                Grid.Row="0"
Grid.Column="0">
                        <Frame.GestureRecognizers>
                            <TapGestureRecognizer Tapped="TapGetData" />
                        </Frame.GestureRecognizers>
                    </Frame>

                </Grid>

                <Grid  Margin="0,10,0,0"
                    Grid.Row="4"
                    Grid.Column="0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Rectangle x:Name="recSendDataLower" 
     Fill="Gray"              
         HeightRequest="90"                      
         Margin="20,10,20,0"
         RadiusX="10"
         RadiusY="10"
         Grid.Row="5"
         Grid.Column="0" />

                    <Rectangle x:Name="recSendDataUpper" 
             Fill="white"      
         Margin="20,0,20,0"     
         HeightRequest="90"      
         Stroke="Gray"
         StrokeThickness="1"
         RadiusX="10"
         RadiusY="10"
         Grid.Row="5"
         Grid.Column="0" />
                    <Grid VerticalOptions="Center"
                        Grid.Row="0" Grid.Column="0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Image x:Name="imgSendData" Source="menuicons/export.png"
                               VerticalOptions="Center"
HorizontalOptions="End"
                               Margin="0,0,20,0"
        Grid.Row="0"
Grid.Column="0"
         HeightRequest="75" 
         WidthRequest="75" >                          
                        </Image>
                        <Label x:Name="lblSendData" 
                               Grid.Row="0"
Grid.Column="1"
         Text="Send Data"
         TextColor="Black"
         FontSize="18"         
         VerticalOptions="Center"
 HorizontalOptions="Start"/>
                    </Grid>

                    <Frame x:Name="frmSendData"
                    BackgroundColor="Transparent"
                    Margin="20,0,20,0"                   
    HeightRequest="90" 
                Grid.Row="0"
Grid.Column="0">
                        <Frame.GestureRecognizers>
                            <TapGestureRecognizer Tapped="TapSendData" />
                        </Frame.GestureRecognizers>
                    </Frame>

                </Grid>

                <Grid  Margin="0,10,0,0"
                    Grid.Row="5"
                    Grid.Column="0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Rectangle x:Name="recBackupLower" Fill="Gray"     

HeightRequest="90"                      
Margin="20,10,20,0"              
RadiusX="10"
RadiusY="10" 
Grid.Row="0"
 Grid.Column="0" />

                    <Rectangle x:Name="recBackupUpper" Fill="white"      
Margin="20,0,20,0"              

HeightRequest="90"      
Stroke="Gray"
StrokeThickness="1"
RadiusX="10"
RadiusY="10"
 Grid.Row="0"
 Grid.Column="0" />
                    <Grid VerticalOptions="Center"
                        Grid.Row="0" Grid.Column="0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Image x:Name="imgBackup" Source="menuicons/backup.png"     
                               VerticalOptions="Center"
HorizontalOptions="End"
                               Margin="0,0,20,0"
        Grid.Row="0"
Grid.Column="0"
         HeightRequest="75" 
         WidthRequest="75" >
                        </Image>
                        <Label x:Name="lblBackup"
    Text="Backup"
                               Grid.Row="0"
Grid.Column="1"         
         TextColor="Black"
         FontSize="18"         
         VerticalOptions="Center"
 HorizontalOptions="Start"/>
                    </Grid>

                    <Frame x:Name="frmBackup" 
                    BackgroundColor="Transparent"
                    Margin="20,0,20,0"                   
    HeightRequest="90" 
                Grid.Row="0"
Grid.Column="0">
                        <Frame.GestureRecognizers>
                            <TapGestureRecognizer Tapped="TapBackup" />
                        </Frame.GestureRecognizers>
                    </Frame>

                </Grid>

                <Grid x:Name="cmdRestore" Margin="0,10,0,0"
                    Grid.Row="6"
                    Grid.Column="0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Rectangle x:Name="recRestoreLower"  Fill="Gray"     
HeightRequest="90"                      
Margin="20,10,20,0"              
RadiusX="10"
RadiusY="10" 
Grid.Row="0"
Grid.Column="0" />
                    <Rectangle x:Name="recRestoreUpper" Fill="white"      
Margin="20,0,20,0"              
HeightRequest="90"      
Stroke="Gray"
StrokeThickness="1"
RadiusX="10"
RadiusY="10"
Grid.Row="0"
Grid.Column="0" />
                    <Grid VerticalOptions="Center"
                        Grid.Row="0" Grid.Column="0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Image x:Name="imgRestore" Source="menuicons/restore.png"            
                               VerticalOptions="Center"
HorizontalOptions="End"
                               Margin="0,0,20,0"
        Grid.Row="0"
Grid.Column="0"
         HeightRequest="75" 
         WidthRequest="75" >
                        </Image>
                        <Label x:Name="lblRestore"
   Text="Restore"
                               Grid.Row="0"
Grid.Column="1"         
         TextColor="Black"
         FontSize="18"         
         VerticalOptions="Center"
 HorizontalOptions="Start"/>
                    </Grid>

                    <Frame x:Name="frmRestore" 
                    BackgroundColor="Transparent"
                    Margin="20,0,20,0"                   
    HeightRequest="90" 
                Grid.Row="0"
Grid.Column="0">
                        <Frame.GestureRecognizers>
                            <TapGestureRecognizer Tapped="TapRestore" />
                        </Frame.GestureRecognizers>
                    </Frame>

                </Grid>

                <Grid x:Name="cmdSettings" Margin="0,10,0,0"                    
                    Grid.Row="7"
                    Grid.Column="0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Rectangle x:Name="recSettingsLower"  Fill="Gray"     
HeightRequest="90"                      
Margin="20,10,20,0"              
RadiusX="10"
RadiusY="10" 
Grid.Row="0"
Grid.Column="0" />
                    <Rectangle x:Name="recSettingsUpper" Fill="white"      
Margin="20,0,20,0"              
HeightRequest="90"      
Stroke="Gray"
StrokeThickness="1"
RadiusX="10"
RadiusY="10"
Grid.Row="0"
Grid.Column="0" />
                    <Grid VerticalOptions="Center"
                        Grid.Row="0" Grid.Column="0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Image x:Name="imgSettings" Source="menuicons/settings.png"        
                               VerticalOptions="Center"
HorizontalOptions="End"
                               Margin="0,0,20,0"
        Grid.Row="0"
Grid.Column="0"
         HeightRequest="75" 
         WidthRequest="75" >
                        </Image>
                        <Label x:Name="lblSettings"
        Text="Settings"
                               Grid.Row="0"
Grid.Column="1"         
         TextColor="Black"
         FontSize="18"         
         VerticalOptions="Center"
 HorizontalOptions="Start"/>
                    </Grid>

                    <Frame x:Name="frmSettings"
                    BackgroundColor="Transparent"
                    Margin="20,0,20,0"                   
    HeightRequest="90" 
                Grid.Row="0"
Grid.Column="0">
                        <Frame.GestureRecognizers>
                            <TapGestureRecognizer Tapped="TapSettings" />
                        </Frame.GestureRecognizers>
                    </Frame>

                </Grid>

                <Grid x:Name="cmdUserAccess"  Margin="0,10,0,0"
                    Grid.Row="8"
                    Grid.Column="0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Rectangle x:Name="recUserLower"  Fill="Gray"     
HeightRequest="90"                      
Margin="20,10,20,0"              
RadiusX="10"
RadiusY="10" 
Grid.Row="0"
Grid.Column="0" />
                    <Rectangle x:Name="recUserUpper" Fill="white"      
Margin="20,0,20,0"              
HeightRequest="90"      
Stroke="Gray"
StrokeThickness="1"
RadiusX="10"
RadiusY="10"
Grid.Row="0"
Grid.Column="0" />
                    <Grid VerticalOptions="Center"
                        Grid.Row="0" Grid.Column="0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Image x:Name="imgUser" Source="menuicons/user_access.png"        
                               VerticalOptions="Center"
HorizontalOptions="End"
                               Margin="0,0,20,0"
        Grid.Row="0"
Grid.Column="0"
         HeightRequest="75" 
         WidthRequest="75" >
                        </Image>
                        <Label x:Name="lblUser"
        Text="User Access"
                               Grid.Row="0"
Grid.Column="1"         
         TextColor="Black"
         FontSize="18"         
         VerticalOptions="Center"
 HorizontalOptions="Start"/>
                    </Grid>

                    <Frame x:Name="frmUser" 
                    BackgroundColor="Transparent"
                    Margin="20,0,20,0"                   
    HeightRequest="90" 
                Grid.Row="0"
Grid.Column="0">
                        <Frame.GestureRecognizers>
                            <TapGestureRecognizer Tapped="TapUsers" />
                        </Frame.GestureRecognizers>
                    </Frame>

                </Grid>

                <Grid x:Name="cmdTestPrint" Margin="0,10,0,0"
                    Grid.Row="9"
                    Grid.Column="0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Rectangle x:Name="recPCLower" Fill="Gray"     
HeightRequest="90"                      
Margin="20,10,20,0"              
RadiusX="10"
RadiusY="10" 
Grid.Row="0"
Grid.Column="0" />
                    <Rectangle x:Name="recPCUpper" Fill="white"      
Margin="20,0,20,0"              
HeightRequest="90"      
Stroke="Gray"
StrokeThickness="1"
RadiusX="10"
RadiusY="10"
Grid.Row="0"
Grid.Column="0" />
                    <Grid VerticalOptions="Center"
                        Grid.Row="0" Grid.Column="0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Image x:Name="imgPC" Source="menuicons/printer_config.png"         
                               VerticalOptions="Center"
HorizontalOptions="End"
                               Margin="0,0,20,0"
        Grid.Row="0"
Grid.Column="0"
         HeightRequest="75" 
         WidthRequest="75" >
                        </Image>
                        <Label x:Name="lblPC"
        Text="Printer Config"
                               Grid.Row="0"
Grid.Column="1"         
         TextColor="Black"
         FontSize="18"         
         VerticalOptions="Center"
 HorizontalOptions="Start"/>
                    </Grid>

                    <Frame x:Name="frmPC" 
                    BackgroundColor="Transparent"
                    Margin="20,0,20,0"                   
    HeightRequest="90" 
                Grid.Row="0"
Grid.Column="0">
                        <Frame.GestureRecognizers>
                            <TapGestureRecognizer Tapped="TapPrinterConfig" />
                        </Frame.GestureRecognizers>
                    </Frame>

                </Grid>           

            </Grid>

            <BoxView x:Name="overlaybox" 
                    Color="Transparent"     
                    HeightRequest="800"
                    WidthRequest="500"
                    Margin ="0,-180,0,0"
                    ZIndex="2"
                    IsVisible="False"
                    HorizontalOptions="FillAndExpand"
                    VerticalOptions="FillAndExpand" />

            <Label x:Name="lblpercentload" 
                    IsVisible="False"
                Text="100%"
                    ZIndex="4"
                    VerticalOptions="Center"
                    HorizontalOptions="Center"
                    FontSize="30"
                       
                />


            <ActivityIndicator x:Name="activityIndicator"    
                                   
                IsRunning="true"
                Color="#3269cd"                   
                HeightRequest="0"
                WidthRequest="0"
                VerticalOptions="CenterAndExpand"
                IsVisible="False"
                ZIndex="3"
                HorizontalOptions="CenterAndExpand" />
        </Grid>

    </ScrollView>
    </AbsoluteLayout>

</ContentPage>