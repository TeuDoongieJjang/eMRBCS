<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="eMRBCS.Pages.UserAccess"
             NavigationPage.HasNavigationBar="False"
             Title="UserAccess">
    <ScrollView>
       
            <Grid VerticalOptions="Start" 
        ZIndex="1">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />                   
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>


            <BoxView Color="#3269cd"
                   HorizontalOptions="FillAndExpand"
                   VerticalOptions="FillAndExpand"
                   HeightRequest="70" 
                   Grid.Row="0"
                   Grid.Column="0"/>

            <Grid Margin="10,10,10,10" Grid.Row="0" Grid.Column="0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <HorizontalStackLayout Grid.Row="0" Grid.Column="0" >
                    <Image Source="menuicons/prev.png"  
    HeightRequest="50" 
    WidthRequest="50" >
                        <Image.GestureRecognizers>
                            <TapGestureRecognizer Tapped="TapImgBack" />
                        </Image.GestureRecognizers>
                    </Image>
                    <Label Margin="5,0,0,0"
Text="User Access"
TextColor="White"
FontSize="18"    
 VerticalOptions="Center"
HorizontalOptions="Start"/>
                </HorizontalStackLayout>

            </Grid>

            <Grid Grid.Row="1" Grid.Column="0" Margin="0,10,0,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />                        
                    </Grid.ColumnDefinitions>
                
                    <Grid x:Name="cmdProfile" 
                        Grid.Row="0"
                        Grid.Column="0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />                           
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <Rectangle x:Name="frmProfileLower" 
                                Fill="Gray"                                     
                                HeightRequest="90"                      
                                 Margin="20,10,20,0"
                                RadiusX="10"
                                RadiusY="10" />

                        <Rectangle x:Name="frmProfileUpper"  Fill="white"                      
                                Margin="20,0,20,0"                           
                                HeightRequest="90"                      
                                Stroke="Gray"
                                StrokeThickness="1"
                                RadiusX="10"
                                RadiusY="10" />
                    <Grid VerticalOptions="Center"
     Grid.Row="0" Grid.Column="0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Image x:Name="imgProfile"  
                            Source="menuicons/userprofile.png" 
                            VerticalOptions="Center"
HorizontalOptions="End"
Margin="0,0,20,0"
                            HeightRequest="75" 
                            WidthRequest="75"
                            Grid.Row="0" Grid.Column="0" >
                        </Image>
                        <Label x:Name="lblProfile" 
                            Text="Profile"
                            Grid.Row="0" Grid.Column="1"
                            TextColor="Black"
                            FontSize="16"                            
                            VerticalOptions="Center"
HorizontalOptions="Start"/>
                    </Grid>               
                        <Frame x:Name="frmProfile"  
                            BackgroundColor="Transparent"
                        Margin="20,0,20,0"                       
     HeightRequest="90">
                            <Frame.GestureRecognizers>
                                <TapGestureRecognizer Tapped="Tapprofile" />
                            </Frame.GestureRecognizers>

                        </Frame>
                    </Grid>
                    <Grid x:Name="cmdAddUser" 
                        Grid.Row="1"
Grid.Column="0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Rectangle x:Name="frmAddEditLower"  
                            Fill="Gray"    

 HeightRequest="90"                     
Margin="20,10,20,0"       
 RadiusX="10"
 RadiusY="10"
  />

                        <Rectangle x:Name="frmAddEditUpper"  Fill="white"                      
Margin="20,0,20,0"       
 HeightRequest="90"                      
 Stroke="Gray"
 StrokeThickness="1"
 RadiusX="10"
 RadiusY="10" />
                    <Grid VerticalOptions="Center"
     Grid.Row="0" Grid.Column="0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Image x:Name="imgAddEdit"   
                                Source="menuicons/usermanagement.png"    
                            VerticalOptions="Center"
HorizontalOptions="End"
Margin="0,0,20,0"
                            HeightRequest="75" 
                            WidthRequest="75"
                            Grid.Row="0" Grid.Column="0" >
                        </Image>
                        <Label x:Name="lblAddEdit"  
    Text="Add / Edit User"
                            Grid.Row="0" Grid.Column="1"
                            TextColor="Black"
                            FontSize="16"                            
                            VerticalOptions="Center"
HorizontalOptions="Start"/>
                    </Grid>                  
                        <Frame x:Name="frmAddEdit"   
                            BackgroundColor="Transparent"
                      Margin="20,0,20,0"       
                      
     HeightRequest="90" >
                            <Frame.GestureRecognizers>
                                <TapGestureRecognizer Tapped="TapAddUser" />
                            </Frame.GestureRecognizers>

                        </Frame>
                    </Grid>
                    <Grid x:Name="cmdUserActivity" IsVisible="true"
                        Grid.Row="2"
Grid.Column="0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Rectangle x:Name="frmActivityLower"   
                            Fill="Gray"     

 HeightRequest="90"                      
Margin="20,10,20,0"  
 RadiusX="10"
 RadiusY="10" />

                        <Rectangle x:Name="frmActivityUpper"   Fill="white"                      
Margin="20,0,20,0"  

 HeightRequest="90"                      
 Stroke="Gray"
 StrokeThickness="1"
 RadiusX="10"
 RadiusY="10"  />
                    <Grid VerticalOptions="Center"
     Grid.Row="0" Grid.Column="0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Image x:Name="imgActivity"   Source="menuicons/user_activity.png"      
                            VerticalOptions="Center"
HorizontalOptions="End"
Margin="0,0,20,0"
                            HeightRequest="75" 
                            WidthRequest="75"
                            Grid.Row="0" Grid.Column="0" >
                        </Image>
                        <Label x:Name="lblActivity"   
    Text="User Activity"
                            Grid.Row="0" Grid.Column="1"
                            TextColor="Black"
                            FontSize="16"                            
                            VerticalOptions="Center"
HorizontalOptions="Start"/>
                    </Grid>                   
                        <Frame x:Name="frmActivity"    
                            BackgroundColor="Transparent"
                       Margin="20,0,20,0"  
                      
     HeightRequest="90"  >
                            <Frame.GestureRecognizers>
                                <TapGestureRecognizer Tapped="TapUserActivity" />
                            </Frame.GestureRecognizers>

                        </Frame>
                    </Grid>
                </Grid>

            </Grid>
        
    </ScrollView>
</ContentPage>