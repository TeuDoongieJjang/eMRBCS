<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="eMRBCS.Pages.Mainmenu"
             NavigationPage.HasNavigationBar="False"
             Title="Mainmenu">
     
    
   
        <AbsoluteLayout>
            <StackLayout x:Name="stackLoading" IsVisible="false" AbsoluteLayout.LayoutBounds="0.5,0.3,200,25"
               AbsoluteLayout.LayoutFlags="PositionProportional"
                ZIndex="3" >
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <BoxView Color="Transparent"
                             
      HorizontalOptions="FillAndExpand"
      VerticalOptions="FillAndExpand"
     
      Grid.Row="0" Grid.RowSpan="3"
      Grid.Column="0"/>
                        <ActivityIndicator x:Name="activityIndicatorPage" Grid.Column="0" Grid.Row="0"                
IsRunning="true"
Color="#3269cd"                   
HeightRequest="100"
WidthRequest="100"
IsVisible="true"
 />
                        <Label x:Name="lblloading"
                        Text="Loading Page" HorizontalOptions="Center" FontAttributes="Bold" FontSize="16" Grid.Column="0" Grid.Row="1"    Margin="15,0,15,10"     TextColor="White"
    />
                        <Label Text="Please wait" HorizontalOptions="Center" FontAttributes="Bold" FontSize="16" Grid.Column="0" Grid.Row="2"    Margin="15,0,15,10"     TextColor="White"
/>

                    </Grid>


                </StackLayout>
        <ScrollView AbsoluteLayout.LayoutBounds="0.5,0,1,1"
                 AbsoluteLayout.LayoutFlags="SizeProportional">
            <Grid >
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>


                <BoxView Color="#3269cd"
                    HorizontalOptions="FillAndExpand"
                    VerticalOptions="FillAndExpand"
                    HeightRequest="70" 
                    Grid.Row="0"
                    Grid.Column="0"/>
                <Grid Margin="10,10,10,10"            Grid.Row="0"
Grid.Column="0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <HorizontalStackLayout 
                    Grid.Row="0"
Grid.Column="0" >
                        <Image Source="menuicons/home.png"                      
   
   HeightRequest="50" 
   WidthRequest="50" >
                        </Image>
                        <Label Margin="5,0,0,0"
   Text="Main Menu"
   TextColor="White"
   FontSize="18"   
   VerticalOptions="Center"
   HorizontalOptions="Start"/>
                    </HorizontalStackLayout>
                    <Image             Grid.Row="0"
Grid.Column="1"
                      Source="menuicons/logout.png"           
                                   VerticalOptions="Center" 
HorizontalOptions="End"
HeightRequest="50" 
WidthRequest="50" >
                        <Image.GestureRecognizers>
                            <TapGestureRecognizer Tapped="TapLogout" />
                        </Image.GestureRecognizers>
                    </Image>

                </Grid>
                <Grid Grid.Row="2"
                 Grid.Column="0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <HorizontalStackLayout Margin="10,10,0,0"
                        Grid.Row="0"
                        Grid.Column="0">
                        <Label TextColor="Black"       
                               FontAttributes="Bold"
                               VerticalOptions="Center"
                                 Text="Status"
                                 FontSize="14" />
                        <Frame x:Name="frameStatus" 
                            Margin="10,0,0,0"
                            HeightRequest="20"
                            WidthRequest="20"
                            CornerRadius="75"
                            BackgroundColor="Green" />
                    </HorizontalStackLayout>

                    <Rectangle Fill="#3269cd"                              
                           Margin="10,10,0,0"
 WidthRequest="200"
 HeightRequest="40"
 RadiusX="0"
 RadiusY="10" Grid.Row="0"
                                Grid.Column="1" />
                    <Label TextColor="White"   
                        VerticalOptions="Center"
                       HorizontalOptions="End"
                       Margin="0,10,20,0"
 Text="User Information"                         
              
 FontSize="14" Grid.Row="0"
                                Grid.Column="1" />

                </Grid>
                <Grid Grid.Row="3"
Grid.Column="0"
                      Margin="10"
                         >
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Label x:Name="lbluserfullname"             
   Text="Name: Juan dela Cruz"
   Margin="10,5,0,0"                 
   FontSize="14"
   HorizontalOptions="Start"
   Grid.Row="0"
   Grid.Column="0" 
         Grid.ColumnSpan="2"/>
                    <Label x:Name="lbllogindate"           
    Text="Login Date/Time: 2024-07-24 10:00 PM"
   Margin="10,5,0,0"            
    FontSize="14"
    HorizontalOptions="Start"
        
    Grid.Row="1"
    Grid.Column="0"
       />
                </Grid>

                <Rectangle x:Name="recDivider" 
                    Fill="#3269cd"                     
                HeightRequest="10"
                Margin="30,10,30,10"
                RadiusX="0"
                RadiusY="10"
                Grid.Row="4"
                Grid.Column="0"/>



                <Grid  Grid.Row="5"
 Grid.Column="0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <Rectangle x:Name="recMRLower" 
                  Fill="Gray"                      
                  HeightRequest="90"                      
                  Margin="20,10,20,0"
                  RadiusX="10"
                  RadiusY="10"
                  Grid.Row="0"
                  Grid.Column="0" />

                    <Rectangle x:Name="recMRUpper" 
                    Fill="white"                      
                  Margin="20,0,20,0"                 
                  HeightRequest="90"                      
                  Stroke="Gray"
                  StrokeThickness="1"
                  RadiusX="10"
                  RadiusY="10"
                  Grid.Row="0"
                  Grid.Column="0" />
                    <Grid 
                      VerticalOptions="Center"
                    Grid.Row="0" Grid.Column="0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Image x:Name="imgMR"  Grid.Row="0"
 Grid.Column="0"
   Source="menuicons/meterreading.png"   
                       VerticalOptions="Center"
                           HorizontalOptions="End"
                           Margin="0,0,20,0"
 HeightRequest="75" 
 WidthRequest="75" >
                        </Image>
                        <Label x:Name="lblMR"  Grid.Row="0"
 Grid.Column="1"
Text="Meter Reading"
TextColor="Black"
                      
FontSize="18"   
VerticalOptions="Center"
HorizontalOptions="Start"/>
                    </Grid>

                    <Frame x:Name="frmMR" 
                    BackgroundColor="Transparent"
                       Margin="20,0,20,0"                       
     HeightRequest="90" 
                    Grid.Row="0"
Grid.Column="0">
                        <Frame.GestureRecognizers>
                            <TapGestureRecognizer Tapped="TapMeterReading" />
                        </Frame.GestureRecognizers>

                    </Frame>
                </Grid>

                <Grid  Grid.Row="6"
Grid.Column="0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <Rectangle x:Name="recCollectLower" 
                    Fill="Gray"     
                 
                  HeightRequest="90"                      
                   Margin="20,10,20,0"
                  RadiusX="10"
                  RadiusY="10"
                  Grid.Row="6"
                  Grid.Column="0" />

                    <Rectangle x:Name="recCollectUpper"  
                    Fill="white"      
                  Margin="20,0,20,0"
                  
                  HeightRequest="90"      
                  Stroke="Gray"
                  StrokeThickness="1"
                  RadiusX="10"
                  RadiusY="10"
                  Grid.Row="6"
                  Grid.Column="0" />
                    <Grid 
                      VerticalOptions="Center"
                    Grid.Row="0" Grid.Column="0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Image x:Name="imgCollection"   Grid.Row="0"
 Grid.Column="0"
    Source="menuicons/collection.png"    
                       VerticalOptions="Center"
                           HorizontalOptions="End"
                            Margin="0,0,20,0"
 HeightRequest="75" 
 WidthRequest="75" >
                        </Image>
                        <Label  x:Name="lblCollection"  Grid.Row="0"
 Grid.Column="1"
Text="Collection"
TextColor="Black"
                       
FontSize="18"   
VerticalOptions="Center"
HorizontalOptions="Start"/>
                    </Grid>


                    <Frame x:Name="frmCollection"  
                    BackgroundColor="Transparent"
                        Margin="20,0,20,0"
                       
     HeightRequest="90" 
                    Grid.Row="6"
Grid.Column="0">
                        <Frame.GestureRecognizers>
                            <TapGestureRecognizer Tapped="TapCollection" />
                        </Frame.GestureRecognizers>

                    </Frame>

                </Grid>

                <Grid  Grid.Row="7"
Grid.Column="0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <Rectangle x:Name="recReportsLower"  
                    Fill="Gray"     
                   
                   HeightRequest="90"                      
                   Margin="20,10,20,0"            
                   RadiusX="10"
                   RadiusY="10"
                   Grid.Row="7"
                   Grid.Column="0" />

                    <Rectangle x:Name="recReportsUpper"   
                    Fill="white"      
                   Margin="20,0,20,0"            
                   
                   HeightRequest="90"      
                   Stroke="Gray"
                   StrokeThickness="1"
                   RadiusX="10"
                   RadiusY="10"
                   Grid.Row="7"
                   Grid.Column="0" />

                    <Grid 
                      VerticalOptions="Center"
                    Grid.Row="0" Grid.Column="0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Image x:Name="imgReports"     Grid.Row="0"
 Grid.Column="0"
 Source="menuicons/reports.png"           
                       VerticalOptions="Center"
                           HorizontalOptions="End"
                           Margin="0,0,20,0"
 HeightRequest="75" 
 WidthRequest="75" >
                        </Image>
                        <Label  x:Name="lblReports"    Grid.Row="0"
 Grid.Column="1"
Text="Reports"
TextColor="Black"                      
FontSize="18"   
VerticalOptions="Center"
HorizontalOptions="Start"/>
                    </Grid>

                    <Frame x:Name="frmReports"   
                    BackgroundColor="Transparent"
                       Margin="20,0,20,0"            
                       
     HeightRequest="90" 
                    Grid.Row="7"
Grid.Column="0">
                        <Frame.GestureRecognizers>
                            <TapGestureRecognizer Tapped="TapReports" />
                        </Frame.GestureRecognizers>

                    </Frame>

                </Grid>

                <Grid  Grid.Row="8"
Grid.Column="0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <Rectangle x:Name="recUtilitiesLower"   
         Fill="Gray"     
       
        HeightRequest="90"                      
        Margin="20,10,20,0"   
        RadiusX="10"
        RadiusY="10"
        Grid.Row="0"
        Grid.Column="0" />

                    <Rectangle x:Name="recUtilitiesUpper"    
         Fill="white"      
        Margin="20,0,20,0"   
        
        HeightRequest="90"      
        Stroke="Gray"
        StrokeThickness="1"
        RadiusX="10"
        RadiusY="10"
        Grid.Row="0"
        Grid.Column="0" />

                    <Grid 
                      VerticalOptions="Center"
                    Grid.Row="0" Grid.Column="0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Image x:Name="imgUtilities"        Grid.Row="0"
 Grid.Column="0"
 Source="menuicons/appconfig.png"            
                       VerticalOptions="Center"
                           HorizontalOptions="End"
                           Margin="0,0,20,0"
 HeightRequest="75" 
 WidthRequest="75" >
                        </Image>
                        <Label x:Name="lblUtilities"   
                      Text="Utilities"    Grid.Row="0"
 Grid.Column="1"
TextColor="Black"                      
FontSize="18"   
VerticalOptions="Center"
HorizontalOptions="Start"/>
                    </Grid>

                    <Frame x:Name="frmUtilities"    
                    BackgroundColor="Transparent"
                       Margin="20,0,20,0"                
     HeightRequest="90" 
                    Grid.Row="8"
Grid.Column="0">
                        <Frame.GestureRecognizers>
                            <TapGestureRecognizer Tapped="TapUtilities" />
                        </Frame.GestureRecognizers>

                    </Frame>


                </Grid>

                <Grid  Grid.Row="9"
Grid.Column="0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <Rectangle x:Name="recProductKeyLower"   
          Fill="Gray"              
         HeightRequest="90"                      
         Margin="20,10,20,0" 
         RadiusX="10"
         RadiusY="10"
         Grid.Row="9"
         Grid.Column="0" />

                    <Rectangle x:Name="recProductKeyUpper"    
          Fill="white"      
         Margin="20,0,20,0"      
         HeightRequest="90"      
         Stroke="Gray"
         StrokeThickness="1"
         RadiusX="10"
         RadiusY="10"
         Grid.Row="9"
         Grid.Column="0" />
                    <Grid 
                      VerticalOptions="Center"
                    Grid.Row="0" Grid.Column="0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Image x:Name="imgProductKey"    
                        Source="menuicons/product_key.png"          
                           Grid.Row="0"
 Grid.Column="0"        
                       VerticalOptions="Center"
                           HorizontalOptions="End"
                           Margin="0,0,20,0"
 HeightRequest="75" 
 WidthRequest="75" >
                        </Image>
                        <Label x:Name="lblProductKey"   
                      Text="Product Activation"    
                           WidthRequest="100"
                           Grid.Row="0"
 Grid.Column="1"
TextColor="Black"                      
FontSize="18"   
VerticalOptions="Center"
HorizontalOptions="Start"/>
                    </Grid>

                    <Frame x:Name="frmProductKey"    
                    BackgroundColor="Transparent"
                       Margin="20,0,20,0"                
     HeightRequest="90" 
                    Grid.Row="8"
Grid.Column="0">
                        <Frame.GestureRecognizers>
                            <TapGestureRecognizer Tapped="TapUtilities" />
                        </Frame.GestureRecognizers>

                    </Frame>


                </Grid>

                <Label Grid.Row="11"
                   Grid.Column="0"
                 Text="Powered by MLS Consultancy Co." 
                   TextColor="Black"
                   Margin="20"
                   FontSize="14"
                   
                   VerticalOptions="Start"
                   HorizontalOptions="Center"/>






            </Grid>
        </ScrollView>
    </AbsoluteLayout>

       



    



</ContentPage>