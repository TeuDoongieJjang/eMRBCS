<?xml version="1.0" encoding="utf-8" ?>
<!--
    Reading.xaml  -  single-screen layout (no page scrolling) tuned for 480x800 devices
    (Honeywell EDA51K) and scaled up automatically for bigger phones.
    Sizes AND spacing are now driven by ApplyScreenScale() in Reading.xaml.cs.
-->
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:pages="clr-namespace:eMRBCS.Pages"
             x:Class="eMRBCS.Pages.Reading"
             NavigationPage.HasNavigationBar="False"
             Title="Reading">

    <ContentPage.Resources>
        <ResourceDictionary>

            <!-- Sizes. ApplyScreenScale() multiplies these by a screen factor at start-up. -->
            <x:Double x:Key="FsCaption">11</x:Double>
            <x:Double x:Key="FsBody">13</x:Double>
            <x:Double x:Key="FsValue">16</x:Double>
            <x:Double x:Key="FsTotal">20</x:Double>
            <x:Double x:Key="FsPad">22</x:Double>
            <x:Double x:Key="FieldH">32</x:Double>
            <x:Double x:Key="PadH">46</x:Double>
            <x:Double x:Key="CmdH">42</x:Double>
            <!-- NEW: top bar / seq no / navigation -->
            <x:Double x:Key="FsTop">16</x:Double>
            <x:Double x:Key="FsTitle">13</x:Double>
            <x:Double x:Key="FsSeq">14</x:Double>
            <x:Double x:Key="FsPadMode">14</x:Double>
            <x:Double x:Key="NavIcon">34</x:Double>
            <x:Double x:Key="OptIcon">32</x:Double>
            <x:Double x:Key="TopH">40</x:Double>

            <!-- Text -->
            <Style x:Key="Cap" TargetType="Label">
                <Setter Property="FontSize" Value="{DynamicResource FsCaption}" />
                <Setter Property="FontAttributes" Value="Bold" />
                <Setter Property="FontAutoScalingEnabled" Value="False" />
                <Setter Property="LineBreakMode" Value="NoWrap" />
                <Setter Property="VerticalOptions" Value="Center" />
                <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource MutedLight}, Dark={StaticResource MutedDark}}" />
            </Style>
            <Style x:Key="Body" TargetType="Label">
                <Setter Property="FontSize" Value="{DynamicResource FsBody}" />
                <Setter Property="FontAutoScalingEnabled" Value="False" />
                <Setter Property="VerticalOptions" Value="Center" />
            </Style>
            <Style x:Key="Val" TargetType="Label">
                <Setter Property="FontSize" Value="{DynamicResource FsValue}" />
                <Setter Property="FontAutoScalingEnabled" Value="False" />
                <Setter Property="VerticalTextAlignment" Value="Center" />
                <Setter Property="LineBreakMode" Value="NoWrap" />
            </Style>

            <!-- Tappable / read-out boxes -->
            <Style x:Key="FieldBase" TargetType="Border">
                <Setter Property="Stroke" Value="{AppThemeBinding Light={StaticResource BorderLightBrush}, Dark={StaticResource BorderDarkBrush}}" />
                <Setter Property="StrokeThickness" Value="1" />
                <Setter Property="Padding" Value="0" />
                <Setter Property="MinimumHeightRequest" Value="{DynamicResource FieldH}" />
                <Setter Property="StrokeShape">
                    <Setter.Value>
                        <RoundRectangle CornerRadius="6" />
                    </Setter.Value>
                </Setter>
            </Style>
            <Style x:Key="Field" TargetType="Border" BasedOn="{StaticResource FieldBase}">
                <Setter Property="BackgroundColor" Value="{AppThemeBinding Light={StaticResource FieldLight}, Dark={StaticResource FieldDark}}" />
            </Style>
            <Style x:Key="FieldBrand" TargetType="Border" BasedOn="{StaticResource FieldBase}">
                <Setter Property="BackgroundColor" Value="{StaticResource Brand}" />
            </Style>
            <Style x:Key="FieldBlack" TargetType="Border" BasedOn="{StaticResource FieldBase}">
                <Setter Property="BackgroundColor" Value="Black" />
            </Style>

            <!-- Buttons -->
            <Style x:Key="CmdBtn" TargetType="Button" BasedOn="{StaticResource BtnBase}">
                <Setter Property="BackgroundColor" Value="{AppThemeBinding Light={StaticResource SoftBtnLight}, Dark={StaticResource SoftBtnDark}}" />
                <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource TextLight}, Dark={StaticResource TextDark}}" />
                <Setter Property="BorderColor" Value="{AppThemeBinding Light={StaticResource BorderLightBrush}, Dark={StaticResource BorderDarkBrush}}" />
                <Setter Property="BorderWidth" Value="1" />
                <Setter Property="FontSize" Value="15" />
                <Setter Property="Padding" Value="0" />
                <Setter Property="HeightRequest" Value="{DynamicResource CmdH}" />
            </Style>
            <!-- Brand colour. Back / Print / Save all use this now. -->
            <Style x:Key="SaveBtn" TargetType="Button" BasedOn="{StaticResource CmdBtn}">
                <Setter Property="BackgroundColor" Value="{StaticResource Brand}" />
                <Setter Property="TextColor" Value="White" />
                <Setter Property="BorderWidth" Value="0" />
                <Style.Triggers>
                    <!-- Print is disabled for unbilled consumers: keep brand colour but dim it -->
                    <Trigger TargetType="Button" Property="IsEnabled" Value="False">
                        <Setter Property="Opacity" Value="0.45" />
                    </Trigger>
                </Style.Triggers>
            </Style>
            <Style x:Key="PadBtn" TargetType="Button" BasedOn="{StaticResource BtnBase}">
                <Setter Property="BackgroundColor" Value="{AppThemeBinding Light={StaticResource PadLight}, Dark={StaticResource PadDark}}" />
                <Setter Property="FontSize" Value="{DynamicResource FsPad}" />
                <Setter Property="FontAttributes" Value="Bold" />
                <Setter Property="Margin" Value="3" />
                <Setter Property="Padding" Value="0" />
                <Setter Property="HeightRequest" Value="{DynamicResource PadH}" />
            </Style>
        </ResourceDictionary>
    </ContentPage.Resources>

    <Grid>

        <!-- ============================== MAIN SCREEN ============================== -->
        <Grid RowDefinitions="Auto,Auto,*">

            <!-- Top bar (now scales) -->
            <Grid x:Name="topBar" Grid.Row="0" ColumnDefinitions="Auto,*,Auto" ColumnSpacing="6" Padding="10,4"
                  MinimumHeightRequest="{DynamicResource TopH}"
                  BackgroundColor="{AppThemeBinding Light={StaticResource Brand}, Dark={StaticResource BrandDark}}">
                <Label x:Name="lblSummaryCount" Grid.Column="0" Text="0 / 0" TextColor="White"
                       FontSize="{DynamicResource FsTop}" FontAttributes="Bold" FontAutoScalingEnabled="False"
                       VerticalOptions="Center" LineBreakMode="NoWrap" MaxLines="1" />
                <Label x:Name="lblListTitle" Grid.Column="1" Text="Unbilled Consumer List" TextColor="White"
                       FontSize="{DynamicResource FsTitle}" FontAttributes="Bold" FontAutoScalingEnabled="False"
                       HorizontalOptions="Center" HorizontalTextAlignment="Center"
                       VerticalOptions="Center" MaxLines="2" LineBreakMode="TailTruncation" />
                <Image x:Name="imgoption" Grid.Column="2" Source="menuicons/options1.png"
                       HeightRequest="{DynamicResource OptIcon}" WidthRequest="{DynamicResource OptIcon}" VerticalOptions="Center">
                    <Image.GestureRecognizers>
                        <TapGestureRecognizer Tapped="TapShowOPtions" />
                    </Image.GestureRecognizers>
                </Image>
            </Grid>
            <!-- Options (hidden until the user taps the icon) -->
            <Grid x:Name="gridOptions" Grid.Row="1" IsVisible="False" ColumnDefinitions="*,Auto" Padding="6,0">
                <Picker x:Name="pickerBillingFilter" Grid.Column="0" FontSize="{DynamicResource FsBody}"
                        SelectedIndexChanged="OnConsumerTypeChanged" Title="Choose Consumer Status" />
                <HorizontalStackLayout Grid.Column="1" VerticalOptions="Center">
                    <CheckBox x:Name="chkPrintOn" IsChecked="False" CheckedChanged="OnCheckPrint" />
                    <Label Text="Auto Print" FontSize="{DynamicResource FsBody}" VerticalOptions="Center" />
                </HorizontalStackLayout>
            </Grid>
            <!-- Details + commands -->
            <Grid x:Name="gridDetails" Grid.Row="2" RowDefinitions="*,Auto" RowSpacing="4" Padding="4,4,4,4">
                <Border Grid.Row="0" Style="{StaticResource Card}" Padding="0">
                    <ScrollView VerticalScrollBarVisibility="Never">
                        <VerticalStackLayout x:Name="detailsStack" Spacing="3" Padding="0,4,0,0">
                            <!-- Seq no + record navigation (now scales) -->
                            <Grid x:Name="seqGrid" Margin="4,0" ColumnDefinitions="Auto,*">
                                <Label x:Name="lblRecordNo" Text="SeqNo: 0" FontAttributes="Bold" FontSize="{DynamicResource FsSeq}"
                       FontAutoScalingEnabled="False" VerticalOptions="Center"
                       TextColor="{AppThemeBinding Light={StaticResource Brand}, Dark={StaticResource BrandSoft}}" />
                                <HorizontalStackLayout x:Name="navButtons" Grid.Column="1" HorizontalOptions="End" Spacing="10">
                                    <Image x:Name="btnStartRecord" Source="menuicons/startrecord.png"
                                           HeightRequest="{DynamicResource NavIcon}" WidthRequest="{DynamicResource NavIcon}">
                                        <Image.GestureRecognizers>
                                            <TapGestureRecognizer Tapped="OnFirstRecordTapped" />
                                        </Image.GestureRecognizers>
                                    </Image>
                                    <Image x:Name="btnPrevRecord" Source="menuicons/prev.png"
                                           HeightRequest="{DynamicResource NavIcon}" WidthRequest="{DynamicResource NavIcon}">
                                        <Image.GestureRecognizers>
                                            <TapGestureRecognizer Tapped="OnPrevRecordTapped" />
                                        </Image.GestureRecognizers>
                                    </Image>
                                    <Image x:Name="btnNextRecord" Source="menuicons/next.png"
                                           HeightRequest="{DynamicResource NavIcon}" WidthRequest="{DynamicResource NavIcon}">
                                        <Image.GestureRecognizers>
                                            <TapGestureRecognizer Tapped="OnNextRecordTapped" />
                                        </Image.GestureRecognizers>
                                    </Image>
                                    <Image x:Name="btnLastRecord" Source="menuicons/endrecord.png"
                                           HeightRequest="{DynamicResource NavIcon}" WidthRequest="{DynamicResource NavIcon}">
                                        <Image.GestureRecognizers>
                                            <TapGestureRecognizer Tapped="OnLastRecordTapped" />
                                        </Image.GestureRecognizers>
                                    </Image>
                                </HorizontalStackLayout>
                            </Grid>

                            <!-- Identity (row/column spacing + caption column set in code) -->
                            <Grid x:Name="identityGrid" Margin="4,0" ColumnDefinitions="66,*,Auto" RowDefinitions="Auto,Auto,Auto,Auto,Auto"
                  RowSpacing="2" ColumnSpacing="2">

                                <Label Grid.Row="0" Grid.Column="0" Text="Acct No" Style="{StaticResource Cap}" />
                                <Border Grid.Row="0" Grid.Column="1" Style="{StaticResource Field}">
                                    <Label x:Name="txtConsumerAcctNo" Style="{StaticResource Val}" FontAttributes="Bold"
                           HorizontalOptions="Fill" VerticalOptions="Fill" Padding="8,0" Text="">
                                        <Label.GestureRecognizers>
                                            <TapGestureRecognizer Tapped="OnAcctNoTapped" />
                                        </Label.GestureRecognizers>
                                    </Label>
                                </Border>
                                <Label x:Name="lblTypeSize" Grid.Row="0" Grid.Column="2" Style="{StaticResource Val}"
                       FontAttributes="Bold" />

                                <Label x:Name="lblPrevAcctNo" Grid.Row="1" Grid.Column="0" Text="Prev Acct"
                       Style="{StaticResource Cap}" IsVisible="False" />
                                <Label x:Name="txtConsumerPrevAcctNo" Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="2"
                       Style="{StaticResource Body}" IsVisible="False" />

                                <Label x:Name="lblName" Grid.Row="2" Grid.Column="0" Text="Name" Style="{StaticResource Cap}">
                                    <Label.GestureRecognizers>
                                        <TapGestureRecognizer Tapped="OnNameTapped" />
                                    </Label.GestureRecognizers>
                                </Label>
                                <Border Grid.Row="2" Grid.Column="1" Grid.ColumnSpan="2" Style="{StaticResource Field}">
                                    <Label x:Name="txtConsumerName" Style="{StaticResource Body}" MaxLines="2"
                           LineBreakMode="TailTruncation" HorizontalOptions="Fill" VerticalOptions="Fill"
                           VerticalTextAlignment="Center" Padding="8,2" Text="">
                                        <Label.GestureRecognizers>
                                            <TapGestureRecognizer Tapped="OnNameTapped" />
                                        </Label.GestureRecognizers>
                                    </Label>
                                </Border>

                                <Label Grid.Row="3" Grid.Column="0" Text="Meter No" Style="{StaticResource Cap}" />
                                <Border Grid.Row="3" Grid.Column="1" Style="{StaticResource Field}">
                                    <Label x:Name="txtConsumerMeterNo" Style="{StaticResource Val}"
                           HorizontalOptions="Fill" VerticalOptions="Fill" Padding="8,0" Text="">
                                        <Label.GestureRecognizers>
                                            <TapGestureRecognizer Tapped="OnMeterNoTapped" />
                                        </Label.GestureRecognizers>
                                    </Label>
                                </Border>
                                <Label x:Name="txtConsumerStatus" Grid.Row="3" Grid.Column="2" Style="{StaticResource Body}" Text="" />

                                <Label x:Name="lbladdress" Grid.Row="4" Grid.Column="0" Text="Address" Style="{StaticResource Cap}" />
                                <Label x:Name="txtConsumerAddress" Grid.Row="4" Grid.Column="1" Grid.ColumnSpan="2"
                       Style="{StaticResource Body}" MaxLines="2" LineBreakMode="TailTruncation" Text="" />
                            </Grid>

                            <!-- ===== READINGS & BILLING band ===== -->
                            <Border x:Name="bandBorder" Margin="0,0,0,0" Padding="4,4,4,4"
        Stroke="{AppThemeBinding Light={StaticResource BorderLightBrush}, Dark={StaticResource BorderDarkBrush}}"
        StrokeThickness="1"
        BackgroundColor="{AppThemeBinding Light=#F5F7FA, Dark=#1F242C}">
                                <Border.StrokeShape>
                                    <RoundRectangle CornerRadius="10" />
                                </Border.StrokeShape>
                                <VerticalStackLayout x:Name="bandStack" Spacing="4">

                                    <Grid ColumnDefinitions="Auto,*,Auto,*,Auto,*,Auto" ColumnSpacing="0">
                                        <VerticalStackLayout Grid.Column="0" Spacing="1">
                                            <Label x:Name="lblAverage" Text="Average" Style="{StaticResource Cap}" />
                                            <Border Style="{StaticResource FieldBlack}">
                                                <Label x:Name="txtConsumerAverage" Style="{StaticResource Val}" Text="0"
                           TextColor="Yellow" HorizontalTextAlignment="End"
                           HorizontalOptions="Fill" VerticalOptions="Fill" Padding="4,0" />
                                            </Border>
                                        </VerticalStackLayout>

                                        <VerticalStackLayout Grid.Column="2" Spacing="1">
                                            <Label x:Name="lblprevreading" Text="Prev Rdg" Style="{StaticResource Cap}" />
                                            <Label x:Name="txtConsumerPrevReading" Style="{StaticResource Val}" Text="0"
                       HeightRequest="{DynamicResource FieldH}" Padding="4,0" />
                                        </VerticalStackLayout>

                                        <VerticalStackLayout Grid.Column="4" Spacing="1">
                                            <Label x:Name="lblpresreading" Text="Pres Rdg" Style="{StaticResource Cap}" />
                                            <Border Style="{StaticResource FieldBrand}">
                                                <Label x:Name="txtConsumerPresReading" Style="{StaticResource Val}" Text=" "
                           TextColor="White" FontAttributes="Bold" HorizontalTextAlignment="End"
                           HorizontalOptions="Fill" VerticalOptions="Fill" Padding="4,0">
                                                    <Label.GestureRecognizers>
                                                        <TapGestureRecognizer Tapped="OnPresReadingTapped" />
                                                    </Label.GestureRecognizers>
                                                </Label>
                                            </Border>
                                        </VerticalStackLayout>

                                        <VerticalStackLayout Grid.Column="6" Spacing="1">
                                            <Label x:Name="lblusage" Text="Usage" Style="{StaticResource Cap}" />
                                            <Label x:Name="txtConsumerUsage" Style="{StaticResource Val}" Text=" " FontAttributes="Bold"
                       HeightRequest="{DynamicResource FieldH}" Padding="0,0" />
                                        </VerticalStackLayout>
                                    </Grid>

                                    <Grid ColumnDefinitions="Auto,*,Auto,*,Auto" ColumnSpacing="0">
                                        <VerticalStackLayout Grid.Column="0" Spacing="1">
                                            <Label x:Name="lblOthers" Text="Other" Style="{StaticResource Cap}" />
                                            <Label x:Name="txtConsumerOthers" Style="{StaticResource Val}" Text="0.00"
                       HeightRequest="{DynamicResource FieldH}" Padding="4,0" />
                                        </VerticalStackLayout>
                                        <VerticalStackLayout Grid.Column="2" Spacing="1">
                                            <Label x:Name="lblArrears" Text="Arrears" Style="{StaticResource Cap}" />
                                            <Label x:Name="txtConsumerArrears" Style="{StaticResource Val}" Text="0.00"
HeightRequest="{DynamicResource FieldH}" Padding="4,0" />
                                        </VerticalStackLayout>
                                        <VerticalStackLayout Grid.Column="4" Spacing="1">
                                            <Label x:Name="lblcurrentbill" Text="Current Bill" Style="{StaticResource Cap}" />
                                            <Label x:Name="txtConsumerCurrentBill" Style="{StaticResource Val}" Text="0.00"
FontAttributes="Bold" HeightRequest="{DynamicResource FieldH}" Padding="4,0" />
                                        </VerticalStackLayout>
                                    </Grid>

                                    <!-- Total Bill -->
                                    <Grid x:Name="totalGrid" ColumnDefinitions="66,*" ColumnSpacing="4">
                                        <Label x:Name="lbltotalbill" Grid.Column="0" Text="Total Bill" Style="{StaticResource Cap}" />
                                        <Border Grid.Column="1" Style="{StaticResource FieldBlack}" MinimumHeightRequest="36">
                                            <Label x:Name="txtConsumerTotalBill" Text="0.00" TextColor="Yellow" FontAttributes="Bold"
                       FontSize="{DynamicResource FsTotal}" FontAutoScalingEnabled="False"
                       HorizontalTextAlignment="End" VerticalTextAlignment="Center"
                       HorizontalOptions="Fill" VerticalOptions="Fill" Padding="8,0" />
                                        </Border>
                                    </Grid>

                                    <!-- Remarks -->
                                    <Grid x:Name="remarksGrid" ColumnDefinitions="66,*" ColumnSpacing="4">
                                        <Label Grid.Column="0" Text="Remarks" Style="{StaticResource Cap}" />
                                        <Border Grid.Column="1" Style="{StaticResource FieldBrand}">
                                            <Grid>
                                                <Label x:Name="txtRemarks" IsVisible="True" Text="Normal Reading" TextColor="White"
                           FontAttributes="Bold" FontSize="{DynamicResource FsBody}" FontAutoScalingEnabled="False"
                           VerticalTextAlignment="Center" HorizontalOptions="Fill" VerticalOptions="Fill"
                           LineBreakMode="TailTruncation" Padding="8,0">
                                                    <Label.GestureRecognizers>
                                                        <TapGestureRecognizer Tapped="OnRemarkTapped" />
                                                    </Label.GestureRecognizers>
                                                </Label>
                                                <Picker x:Name="pickerRemarks" IsVisible="False" Title="Choose Remarks"
                            TextColor="White" TitleColor="White" FontSize="{DynamicResource FsBody}" Margin="4,0"
                            SelectedIndexChanged="OnRemarkChanged"
                            Focused="OnRemarkFocus" Unfocused="OnRemarkUnFocus" />
                                            </Grid>
                                        </Border>
                                    </Grid>

                                </VerticalStackLayout>
                            </Border>

                        </VerticalStackLayout>
                    </ScrollView>
                </Border>

                <!-- Commands: Back / Print / Save all use the brand colour -->
                <Grid x:Name="gridCommands" Grid.Row="1" ColumnDefinitions="*,*,*" ColumnSpacing="6">
                    <Button x:Name="btnCloseDetails" Grid.Column="0" Text="Back" Style="{StaticResource SaveBtn}"
                            Clicked="OnCloseDetails" Focused="OnSaveFocus" Unfocused="OnSaveUnFocus" />
                    <Button x:Name="btnPrint" Grid.Column="1" Text="Print" Style="{StaticResource SaveBtn}"
                            Clicked="OnPrintBill" Focused="OnSaveFocus" Unfocused="OnSaveUnFocus" />
                    <Button x:Name="btnSave" Grid.Column="2" Text="Save" Style="{StaticResource SaveBtn}"
                            Clicked="OnSaveReading" Focused="OnSaveFocus" Unfocused="OnSaveUnFocus" />
                </Grid>
            </Grid>
        </Grid>

        <!-- ============================== NUMERIC PAD (overlay) ============================== -->
        <Grid x:Name="gridNumericPad" IsVisible="False" BackgroundColor="#B3000000" ZIndex="5">
            <Border Style="{StaticResource Card}" Stroke="{StaticResource Brand}" StrokeThickness="2"
                    HorizontalOptions="Fill" VerticalOptions="Center" Margin="10" Padding="6">
                <Grid x:Name="gridButtons" RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto"
                      ColumnDefinitions="*,*,*,*">

                    <Label x:Name="lblPadMode" Grid.Row="0" Grid.ColumnSpan="4"
                           HorizontalOptions="Center" HorizontalTextAlignment="Center"
                           FontAttributes="Bold" FontSize="{DynamicResource FsPadMode}" FontAutoScalingEnabled="False" Margin="0,2,0,4"
                           TextColor="{AppThemeBinding Light={StaticResource Brand}, Dark={StaticResource BrandSoft}}" />

                    <Border Grid.Row="1" Grid.ColumnSpan="4" Margin="3,0,3,3" Style="{StaticResource FieldBase}"
                            BackgroundColor="{AppThemeBinding Light=#EEEEEE, Dark=#2E2E2E}">
                        <Entry x:Name="txtCustomEntry" Text="0.00" FontSize="26" FontAttributes="Bold"
                               HorizontalTextAlignment="End" IsReadOnly="True" MinimumHeightRequest="46" />
                    </Border>

                    <Button x:Name="btnNumber7" Style="{StaticResource PadBtn}" Grid.Row="2" Grid.Column="0" Clicked="OnClickB7" Text="7" />
                    <Button x:Name="btnNumber8" Style="{StaticResource PadBtn}" Grid.Row="2" Grid.Column="1" Clicked="OnClickB8" Text="8" />
                    <Button x:Name="btnNumber9" Style="{StaticResource PadBtn}" Grid.Row="2" Grid.Column="2" Clicked="OnClickB9" Text="9" />
                    <Button x:Name="btnClear"   Style="{StaticResource PadBtn}" Grid.Row="2" Grid.Column="3" Clicked="OnClickClear" Text="C" BackgroundColor="#C0392B" />

                    <Button x:Name="btnNumber4" Style="{StaticResource PadBtn}" Grid.Row="3" Grid.Column="0" Clicked="OnClickB4" Text="4" />
                    <Button x:Name="btnNumber5" Style="{StaticResource PadBtn}" Grid.Row="3" Grid.Column="1" Clicked="OnClickB5" Text="5" />
                    <Button x:Name="btnNumber6" Style="{StaticResource PadBtn}" Grid.Row="3" Grid.Column="2" Clicked="OnClickB6" Text="6" />
                    <Button x:Name="btnDel"     Style="{StaticResource PadBtn}" Grid.Row="3" Grid.Column="3" Clicked="OnClickBackSpace" Text="⌫" />

                    <Button x:Name="btnNumber1" Style="{StaticResource PadBtn}" Grid.Row="4" Grid.Column="0" Clicked="OnClickB1" Text="1" />
                    <Button x:Name="btnNumber2" Style="{StaticResource PadBtn}" Grid.Row="4" Grid.Column="1" Clicked="OnClickB2" Text="2" />
                    <Button x:Name="btnNumber3" Style="{StaticResource PadBtn}" Grid.Row="4" Grid.Column="2" Clicked="OnClickB3" Text="3" />
                    <Button x:Name="btnok"      Style="{StaticResource PadBtn}" Grid.Row="4" Grid.Column="3" Clicked="OnClickOk" Text="OK" FontSize="18"
                            BackgroundColor="{StaticResource Brand}" />

                    <Button x:Name="btnNumber0" Style="{StaticResource PadBtn}" Grid.Row="5" Grid.Column="0" Clicked="OnClickB0" Text="0" />
                    <Button x:Name="btnPeriod"  Style="{StaticResource PadBtn}" Grid.Row="5" Grid.Column="1" Clicked="OnClickPeriod" Text="." />
                    <Button x:Name="btnDash"    Style="{StaticResource PadBtn}" Grid.Row="5" Grid.Column="2" Clicked="OnClickDash" Text="-" />
                    <Button x:Name="btnCancel"  Style="{StaticResource PadBtn}" Grid.Row="5" Grid.Column="3" Clicked="OnClickCancel" Text="Back" FontSize="13" />
                </Grid>
            </Border>
        </Grid>

        <!-- ============================== BUSY OVERLAY ============================== -->
        <Grid x:Name="busyOverlay" IsVisible="False" BackgroundColor="#99000000" ZIndex="10">
            <VerticalStackLayout VerticalOptions="Center" HorizontalOptions="Center" Spacing="12">
                <ActivityIndicator IsRunning="True" Color="White" WidthRequest="56" HeightRequest="56" />
                <Label x:Name="lblBusy" Text="Please wait..." TextColor="White" FontSize="16"
                       HorizontalTextAlignment="Center" />
            </VerticalStackLayout>
        </Grid>

        <!-- ============================== SEARCH RESULTS ============================== -->
        <Grid x:Name="gridSearchResults" IsVisible="False" BackgroundColor="#99000000" ZIndex="11">
            <Border Style="{StaticResource Card}" StrokeThickness="0" Margin="14,40" Padding="0">
                <Grid RowDefinitions="Auto,Auto,*,Auto">
                    <Label x:Name="lblSearchMode" Grid.Row="0" BackgroundColor="{StaticResource Brand}" TextColor="White"
                           FontAttributes="Bold" FontSize="15" Padding="12,8" />
                    <Label x:Name="lblSearchSubtitle" Grid.Row="1" FontSize="12" Margin="12,6"
                           TextColor="{AppThemeBinding Light={StaticResource MutedLight}, Dark={StaticResource MutedDark}}" />

                    <CollectionView x:Name="lstSearchResults" Grid.Row="2" SelectionMode="None">
                        <CollectionView.ItemTemplate>
                            <DataTemplate x:DataType="pages:SearchResultItem">
                                <VerticalStackLayout>
                                    <Label Text="{Binding Text}" FontSize="14" Padding="12,10" />
                                    <BoxView HeightRequest="1"
                                             Color="{AppThemeBinding Light={StaticResource FrameBorderLight}, Dark={StaticResource FrameBorderDark}}" />
                                    <VerticalStackLayout.GestureRecognizers>
                                        <TapGestureRecognizer Tapped="OnSearchResultTapped" />
                                    </VerticalStackLayout.GestureRecognizers>
                                </VerticalStackLayout>
                            </DataTemplate>
                        </CollectionView.ItemTemplate>
                    </CollectionView>

                    <Button Grid.Row="3" Text="Cancel" Margin="10" Clicked="OnSearchResultsCancel" />
                </Grid>
            </Border>
        </Grid>
    </Grid>
</ContentPage>